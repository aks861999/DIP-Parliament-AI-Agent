# example.env
# Copy to .env at the repo root and fill in real values before first run:
#   cp example.env .env
#
# --- mcp-server ---
DIP_API_BASE_URL=https://search.dip.bundestag.de/api/v1
# A DIP API key is optional (DipClient works key-less at DIP's basic
# tier) but raises the rate limit — filled in from day one here rather
# than discovered mid-development.
DIP_API_KEY='R2BZaee.DjdCyihKZMf8AOjtScubP2EVydegzjmBIQ'
MCP_CACHE_TTL_SECONDS=1800



# Native-run only — Docker Compose hardcodes redis://redis:6379/1 for this var
# (see docker-compose.yaml comment) since "redis" only resolves inside the
# Compose network.
REDIS_URL=redis://localhost:6379/1



# --- agent-app / LLM ---
LLM_BASE_URL=
LLM_MODEL=<your_model_name>
LLM_API_KEY="get_it_from_openai"
LLM_REQUESTS_PER_MINUTE=100
LLM_MAX_RETRIES=3

# --- Feature flags ---
ENABLE_REFLECTION=true
ENABLE_HALLUCINATION_GUARD=true
# Gates Stage 2 (LLM-as-judge fallback) of the faithfulness cascade —
# fires only when the Stage-1 NLI score is below FAITHFULNESS_THRESHOLD.
# Set to false to reproduce the NLI-only behavior; leave true for the
# full two-stage cascade.
ENABLE_LLM_FALLBACK_GUARD=true
ENABLE_HITL=true
FAITHFULNESS_THRESHOLD=0.8
COMPLETENESS_THRESHOLD=0.7

# --- Langfuse tracing (REQUIRED — app.py refuses to start without both) ---
LANGFUSE_SECRET_KEY="get_it_from_langfuse"
LANGFUSE_PUBLIC_KEY="get_it_from_langfuse"
LANGFUSE_HOST="https://cloud.langfuse.com"

# --- Persistence (Postgres) ---
# Native/non-Docker: point at localhost. Docker Compose overrides this to
# point at the "postgres" service hostname internally (see docker-compose.yaml).
DATABASE_URL=postgresql://dip_agent:<POSTGRES_PASSWORD>@localhost:5432/dip_agent
# Used only by docker-compose.yaml to provision the postgres container —
# irrelevant if Postgres is installed/provisioned natively.
POSTGRES_USER=dip_agent
POSTGRES_PASSWORD='set_your_password'
POSTGRES_DB=dip_agent

# --- Logging ---
LOG_LEVEL=INFO



MAX_REFLECTION_ITERATIONS=2





AGENT_QUERY_TIMEOUT_SECONDS=180
AGENT_SERVICE_URL=http://agent-service:8000


# --- mcp-server (moved out of code defaults) ---
MCP_TRANSPORT=sse
PREWARM_ON_STARTUP=true
NAME_DIRECTORY_TTL_SECONDS=86400
