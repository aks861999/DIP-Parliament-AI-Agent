# services/full-stack-agent-app/.gitignore
# Rename this file to exactly ".gitignore" (no extension) once downloaded.

# dependencies
/node_modules

# next.js build output
/.next/
/out/

# production build
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files -- never commit real secrets
.env
.env.local
.env.*.local

# typescript
*.tsbuildinfo
next-env.d.ts
